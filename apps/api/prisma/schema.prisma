generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReadingType {
  BIRTH_CHART
  HOROSCOPE
  TAROT
  NUMEROLOGY
  PALM
  DREAM
  COMPATIBILITY
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  role          Role           @default(USER)
  disabled      Boolean        @default(false)
  createdAt     DateTime       @default(now())
  lastSeenAt    DateTime?
  profiles      BirthProfile[]
  readings      Reading[]
  conversations Conversation[]
  usage         AiUsage[]
}

// A person whose birth details are known. Every user has one "self" profile
// and may add family members or partners for charts and matching.
model BirthProfile {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  relation   String    @default("self")
  gender     String?
  birthDate  String // YYYY-MM-DD
  birthTime  String? // HH:mm, local time at the birth place
  birthPlace String
  latitude   Float
  longitude  Float
  timezone   String
  createdAt  DateTime  @default(now())
  readings   Reading[]

  @@index([userId])
}

model Reading {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId      String?
  profile        BirthProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  type           ReadingType
  title          String
  input          Json
  data           Json
  interpretation String
  model          String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String    @default("New consultation")
  topic     String    @default("general")
  // Reading the person opened this conversation from, if any.
  focusReadingId String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]
  readings  Reading[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user | assistant | tool
  role           String
  content        String
  imageDataUrl   String?
  toolCalls      Json?
  toolCallId     String?
  toolName       String?
  model          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  task             String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cost             Float?
  latencyMs        Int
  error            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
