generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ReadingType {
  BIRTH_CHART
  HOROSCOPE
  TAROT
  NUMEROLOGY
  PALM
  DREAM
  COMPATIBILITY
}

model User {
  id                  String           @id @default(cuid())
  email               String           @unique
  passwordHash        String
  name                String
  role                Role             @default(USER)
  // Blocked accounts cannot sign in or use the API.
  disabled            Boolean          @default(false)
  // Per-user override of the default AI credit allowance (1 credit =
  // $0.001 of model cost). Null means the default applies.
  creditLimit         Int?
  unlimitedCredits    Boolean          @default(false)
  // Bought or granted credits, used once the free allowance is spent.
  creditBalance       Float            @default(0)
  // Set once the person enters the code emailed to them.
  emailVerifiedAt     DateTime?
  verifyCodeHash      String?
  verifyCodeExpiresAt DateTime?
  verifyCodeSentAt    DateTime?
  verifyAttempts      Int              @default(0)
  createdAt           DateTime         @default(now())
  lastSeenAt          DateTime?
  profiles            BirthProfile[]
  readings            Reading[]
  conversations       Conversation[]
  usage               AiUsage[]
  paymentRequests     PaymentRequest[]
  creditGrants        CreditGrant[]
}

// A person whose birth details are known. Every user has one "self" profile
// and may add family members or partners for charts and matching.
model BirthProfile {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  relation   String    @default("self")
  gender     String?
  birthDate  String // YYYY-MM-DD
  birthTime  String? // HH:mm, local time at the birth place
  birthPlace String
  latitude   Float
  longitude  Float
  timezone   String
  createdAt  DateTime  @default(now())
  readings   Reading[]

  @@index([userId])
}

model Reading {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  profileId      String?
  profile        BirthProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  type           ReadingType
  title          String
  input          Json
  data           Json
  interpretation String
  model          String?
  createdAt      DateTime      @default(now())

  @@index([userId, createdAt])
}

model Conversation {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String    @default("New consultation")
  topic          String    @default("general")
  // Reading the person opened this conversation from, if any.
  focusReadingId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  messages       Message[]
  readings       Reading[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // user | assistant | tool
  role           String
  content        String
  imageDataUrl   String?
  toolCalls      Json?
  toolCallId     String?
  toolName       String?
  model          String?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  task             String
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  cost             Float?
  latencyMs        Int
  error            String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// A customer's claim that they paid by UPI, with the screenshot as proof.
// An admin checks it and approves (adding credits) or declines it.
model PaymentRequest {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits      Int
  rupees       Int
  screenshot   String
  // pending | approved | rejected
  status       String    @default("pending")
  // Credits actually added on approval (may differ from the request).
  creditsAdded Int?
  // Shown to the customer; required when rejecting.
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Every change to a user's credit balance made by an admin.
model CreditGrant {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits     Float
  note        String?
  paymentId   String?
  grantedById String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Every email the app tried to send, for the admin console.
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  // reading, verification, payment, campaign, alert, test
  kind      String
  status    String
  error     String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
